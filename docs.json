{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "HIJ Search Docs",
  "description": "Integrate HIJ Search with a Shopify store: install the app, choose the Storefront API or a JS SDK (full stack or headless), send analytics, then add A/B testing and recipes. The SDKs and the GTM template are versioned on their own.",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#3730A3"
  },
  "variables": {
    "UI_WIDGETS_VERSION": "3.0.20",
    "UI_WIDGETS_LEGACY_VERSION": "2.1.8",
    "CONNECTOR_VERSION": "3.0.21",
    "CONNECTOR_LEGACY_VERSION": "2.4.3"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get started",
        "icon": "rocket",
        "groups": [
          {
            "group": "Integrate HIJ with Shopify",
            "pages": [
              "index",
              "get-started/install-app",
              "get-started/credentials",
              "get-started/choose-your-path",
              "get-started/verify"
            ]
          }
        ]
      },
      {
        "tab": "Storefront API",
        "icon": "code",
        "openapi": "api/openapi.yaml",
        "groups": [
          {
            "group": "Storefront API v2",
            "pages": [
              "storefront-api/overview",
              "storefront-api/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "storefront-api/endpoints/search",
              "storefront-api/endpoints/suggestions",
              "storefront-api/endpoints/collection"
            ]
          },
          {
            "group": "Next step",
            "pages": [
              "storefront-api/analytics-required"
            ]
          }
        ]
      },
      {
        "tab": "JS SDKs",
        "icon": "js",
        "menu": [
          {
            "item": "Overview",
            "icon": "compass",
            "description": "Full stack or headless, and the browser-only rule",
            "anchors": [
              {
                "anchor": "Overview",
                "icon": "compass",
                "groups": [
                  {
                    "group": "JS SDKs",
                    "pages": [
                      "sdks/overview",
                      "sdks/server-side"
                    ]
                  }
                ]
              },
              {
                "anchor": "Full stack",
                "icon": "table-cells",
                "href": "/full-stack/quick-start"
              },
              {
                "anchor": "Headless",
                "icon": "plug",
                "href": "/headless/quick-start"
              }
            ]
          },
          {
            "item": "Full stack",
            "icon": "table-cells",
            "description": "UI widgets SDK, HIJ.UIWidgets.*",
            "dropdowns": [
              {
                "dropdown": "Overview",
                "icon": "compass",
                "description": "Full stack or headless, and the browser-only rule",
                "href": "/sdks/overview"
              },
              {
                "dropdown": "Full stack",
                "icon": "table-cells",
                "description": "UI widgets SDK, HIJ.UIWidgets.*",
                "versions": [
                  {
                    "version": "Full stack 3.x",
                    "default": true,
                    "tag": "Latest",
                    "groups": [
                      {
                        "group": "Get started",
                        "pages": [
                          "full-stack/quick-start"
                        ]
                      },
                      {
                        "group": "Widgets",
                        "pages": [
                          "full-stack/search-results",
                          "full-stack/search-suggestions",
                          "full-stack/failover"
                        ]
                      }
                    ]
                  },
                  {
                    "version": "Full stack 2.x",
                    "tag": "Legacy",
                    "groups": [
                      {
                        "group": "Full stack 2.x",
                        "pages": [
                          "full-stack/v2/quick-start",
                          "full-stack/v2/search-results"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "dropdown": "Headless",
                "icon": "plug",
                "description": "Connector SDK, HIJ.Connector.*",
                "href": "/headless/quick-start"
              }
            ]
          },
          {
            "item": "Headless",
            "icon": "plug",
            "description": "Connector SDK, HIJ.Connector.*",
            "dropdowns": [
              {
                "dropdown": "Overview",
                "icon": "compass",
                "description": "Full stack or headless, and the browser-only rule",
                "href": "/sdks/overview"
              },
              {
                "dropdown": "Full stack",
                "icon": "table-cells",
                "description": "UI widgets SDK, HIJ.UIWidgets.*",
                "href": "/full-stack/quick-start"
              },
              {
                "dropdown": "Headless",
                "icon": "plug",
                "description": "Connector SDK, HIJ.Connector.*",
                "versions": [
                  {
                    "version": "Headless 3.x",
                    "default": true,
                    "tag": "Latest",
                    "groups": [
                      {
                        "group": "Get started",
                        "pages": [
                          "headless/quick-start"
                        ]
                      },
                      {
                        "group": "Connectors",
                        "pages": [
                          "headless/collections",
                          "headless/failover"
                        ]
                      }
                    ]
                  },
                  {
                    "version": "Headless 2.x",
                    "tag": "Legacy",
                    "groups": [
                      {
                        "group": "Headless 2.x",
                        "pages": [
                          "headless/v2/quick-start",
                          "headless/v2/collections"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Analytics",
        "icon": "chart-line",
        "menu": [
          {
            "item": "Analytics",
            "icon": "chart-line",
            "description": "Which events, who sends them, and how",
            "anchors": [
              {
                "anchor": "Analytics",
                "icon": "chart-line",
                "groups": [
                  {
                    "group": "Analytics",
                    "pages": [
                      "analytics/overview",
                      "analytics/shopify-pixel",
                      "analytics/analytics-api",
                      "analytics/sdk-manual"
                    ]
                  }
                ]
              },
              {
                "anchor": "GTM template",
                "icon": "tags",
                "href": "/analytics/gtm/setup"
              }
            ]
          },
          {
            "item": "GTM template",
            "icon": "tags",
            "description": "Google Tag Manager tag template releases",
            "dropdowns": [
              {
                "dropdown": "Analytics",
                "icon": "chart-line",
                "description": "Which events, who sends them, and how",
                "href": "/analytics/overview"
              },
              {
                "dropdown": "GTM template",
                "icon": "tags",
                "description": "Google Tag Manager tag template releases",
                "versions": [
                  {
                    "version": "GTM r20260217",
                    "default": true,
                    "tag": "Latest",
                    "groups": [
                      {
                        "group": "GTM template",
                        "pages": [
                          "analytics/gtm/setup"
                        ]
                      }
                    ]
                  },
                  {
                    "version": "GTM r20250801",
                    "tag": "Legacy",
                    "groups": [
                      {
                        "group": "GTM template r20250801",
                        "pages": [
                          "analytics/gtm/r20250801/setup"
                        ]
                      }
                    ]
                  },
                  {
                    "version": "GTM r20240718",
                    "tag": "Legacy",
                    "groups": [
                      {
                        "group": "GTM template r20240718",
                        "pages": [
                          "analytics/gtm/r20240718/setup"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "A/B testing",
        "icon": "flask",
        "groups": [
          {
            "group": "A/B testing",
            "pages": [
              "ab-testing/overview",
              "ab-testing/liquid",
              "ab-testing/hydrogen-oxygen",
              "ab-testing/remix"
            ]
          }
        ]
      },
      {
        "tab": "Checkout recommendations",
        "icon": "cart-shopping",
        "groups": [
          {
            "group": "Checkout recommendations",
            "pages": [
              "checkout-recommendations/overview",
              "checkout-recommendations/style-builder"
            ]
          }
        ]
      },
      {
        "tab": "Recipes",
        "icon": "book-open",
        "groups": [
          {
            "group": "Recipes",
            "pages": [
              "recipes/index",
              "recipes/colour-swatches",
              "recipes/similar-products-pdp",
              "recipes/lazy-widget-init",
              "recipes/multi-market"
            ]
          }
        ]
      },
      {
        "tab": "Changelogs",
        "icon": "clock-rotate-left",
        "groups": [
          {
            "group": "Changelogs",
            "pages": [
              "full-stack/changelog",
              "headless/changelog",
              "storefront-api/changelog",
              "analytics/gtm/changelog"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "redirects": [
    {
      "source": "/gtm/setup",
      "destination": "/analytics/gtm/setup"
    },
    {
      "source": "/gtm/r20250801/setup",
      "destination": "/analytics/gtm/r20250801/setup"
    },
    {
      "source": "/gtm/r20240718/setup",
      "destination": "/analytics/gtm/r20240718/setup"
    },
    {
      "source": "/gtm/:slug*",
      "destination": "/analytics/gtm/:slug*"
    },
    {
      "source": "/ab-testing/setup-liquid",
      "destination": "/ab-testing/liquid"
    },
    {
      "source": "/quick-start",
      "destination": "/full-stack/quick-start"
    },
    {
      "source": "/ui-widgets/:slug*",
      "destination": "/full-stack/:slug*"
    },
    {
      "source": "/v2/ui-widgets/:slug*",
      "destination": "/full-stack/v2/:slug*"
    },
    {
      "source": "/legacy/:slug*",
      "destination": "/full-stack/v2/:slug*"
    },
    {
      "source": "/connector/collections",
      "destination": "/headless/collections"
    },
    {
      "source": "/changelog/connector",
      "destination": "/headless/changelog"
    },
    {
      "source": "/reuse/page-a",
      "destination": "/full-stack/failover"
    },
    {
      "source": "/reuse/page-b",
      "destination": "/headless/failover"
    },
    {
      "source": "/api/overview",
      "destination": "/storefront-api/overview"
    },
    {
      "source": "/api/endpoints/:slug*",
      "destination": "/storefront-api/endpoints/:slug*"
    }
  ],
  "footer": {
    "socials": {}
  }
}
