{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "HIJ Search Docs",
  "description": "HIJ Search developer documentation. Each product (full stack, headless, Storefront API, A/B testing, GTM template) is versioned on its own.",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#3730A3"
  },
  "variables": {
    "UI_WIDGETS_VERSION": "3.0.20",
    "UI_WIDGETS_LEGACY_VERSION": "2.1.8",
    "CONNECTOR_VERSION": "3.0.21",
    "CONNECTOR_LEGACY_VERSION": "2.4.3"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index"]
          }
        ]
      },
      {
        "tab": "Full stack",
        "versions": [
          {
            "version": "Full stack 3.x",
            "default": true,
            "tag": "Latest",
            "groups": [
              {
                "group": "Get started",
                "pages": ["full-stack/quick-start"]
              },
              {
                "group": "Widgets",
                "pages": ["full-stack/search-results", "full-stack/search-suggestions", "full-stack/failover"]
              },
              {
                "group": "Release notes",
                "pages": ["full-stack/changelog"]
              }
            ]
          },
          {
            "version": "Full stack 2.x",
            "tag": "Legacy",
            "groups": [
              {
                "group": "Full stack 2.x",
                "pages": ["full-stack/v2/quick-start", "full-stack/v2/search-results"]
              }
            ]
          }
        ]
      },
      {
        "tab": "Headless",
        "versions": [
          {
            "version": "Headless 3.x",
            "default": true,
            "tag": "Latest",
            "groups": [
              {
                "group": "Get started",
                "pages": ["headless/quick-start"]
              },
              {
                "group": "Connectors",
                "pages": ["headless/collections", "headless/failover"]
              },
              {
                "group": "Release notes",
                "pages": ["headless/changelog"]
              }
            ]
          },
          {
            "version": "Headless 2.x",
            "tag": "Legacy",
            "groups": [
              {
                "group": "Headless 2.x",
                "pages": ["headless/v2/quick-start", "headless/v2/collections"]
              }
            ]
          }
        ]
      },
      {
        "tab": "Storefront API",
        "openapi": "api/openapi.yaml",
        "groups": [
          {
            "group": "Storefront API v2",
            "pages": [
              "storefront-api/overview",
              "storefront-api/endpoints/search",
              "storefront-api/endpoints/suggestions",
              "storefront-api/endpoints/collection"
            ]
          }
        ]
      },
      {
        "tab": "A/B testing",
        "groups": [
          {
            "group": "A/B testing",
            "pages": ["ab-testing/setup-liquid"]
          }
        ]
      },
      {
        "tab": "GTM",
        "versions": [
          {
            "version": "r20260217",
            "default": true,
            "tag": "Latest",
            "groups": [
              {
                "group": "GTM template",
                "pages": ["gtm/setup"]
              }
            ]
          },
          {
            "version": "r20250801",
            "tag": "Legacy",
            "groups": [
              {
                "group": "GTM template r20250801",
                "pages": ["gtm/r20250801/setup"]
              }
            ]
          },
          {
            "version": "r20240718",
            "tag": "Legacy",
            "groups": [
              {
                "group": "GTM template r20240718",
                "pages": ["gtm/r20240718/setup"]
              }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "redirects": [
    { "source": "/quick-start", "destination": "/full-stack/quick-start" },
    { "source": "/ui-widgets/:slug*", "destination": "/full-stack/:slug*" },
    { "source": "/v2/ui-widgets/:slug*", "destination": "/full-stack/v2/:slug*" },
    { "source": "/legacy/:slug*", "destination": "/full-stack/v2/:slug*" },
    { "source": "/connector/collections", "destination": "/headless/collections" },
    { "source": "/changelog/connector", "destination": "/headless/changelog" },
    { "source": "/reuse/page-a", "destination": "/full-stack/failover" },
    { "source": "/reuse/page-b", "destination": "/headless/failover" },
    { "source": "/api/overview", "destination": "/storefront-api/overview" },
    { "source": "/api/endpoints/:slug*", "destination": "/storefront-api/endpoints/:slug*" }
  ],
  "footer": {
    "socials": {}
  }
}
