  "redirects": [
    {
      "source": "/gtm/setup",
      "destination": "/analytics/gtm/setup"
    },
    {
      "source": "/gtm/r20250801/setup",
      "destination": "/analytics/gtm/r20250801/setup"
    },
    {
      "source": "/gtm/r20240718/setup",
      "destination": "/analytics/gtm/r20240718/setup"
    },
    {
      "source": "/gtm/:slug",
      "destination": "/analytics/gtm/:slug"
    },
    {
      "source": "/gtm/:release/:slug",
      "destination": "/analytics/gtm/:release/:slug"
    },
    {
      "source": "/ab-testing/setup-liquid",
      "destination": "/ab-testing/liquid"
    },
    {
      "source": "/quick-start",
      "destination": "/full-stack/quick-start"
    },
    {
      "source": "/ui-widgets/:slug",
      "destination": "/full-stack/:slug"
    },
    {
      "source": "/v2/ui-widgets/:slug",
      "destination": "/full-stack/v2/:slug"
    },
    {
      "source": "/legacy/ui-widgets/:slug",
      "destination": "/full-stack/v2/:slug"
    },
    {
      "source": "/legacy/:slug",
      "destination": "/full-stack/v2/:slug"
    },
    {
      "source": "/connector/collections",
      "destination": "/headless/collections"
    },
    {
      "source": "/changelog/connector",
      "destination": "/headless/changelog"
    },
    {
      "source": "/reuse/page-a",
      "destination": "/full-stack/failover"
    },
    {
      "source": "/reuse/page-b",
      "destination": "/headless/failover"
    },
    {
      "source": "/api/overview",
      "destination": "/storefront-api/overview"
    },
    {
      "source": "/api/endpoints/:slug",
      "destination": "/storefront-api/endpoints/:slug"
    }
  ],
  "seo": {
    "llms-txt:enabled": true
  },
  "ai": {
    "page-actions": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "perplexity",
      "mcp"
    ]
  },
  "customCss": [
    {
      "src": "styles/hij-nav.css"
    }
  ],
  "scripts": [
    {
      "src": "scripts/hij-nav.js"
    }
  ]
}